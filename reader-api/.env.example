# 环境变量示例：复制为 .env 并填写真实值，切勿将真实密钥提交到代码库
# JWT 签名密钥（生产环境必须更换为高强度随机值）
JWT_SECRET=change-me-to-a-long-random-secret
# MySQL（如与本机默认不同可覆盖）
DB_URL=jdbc:mysql://localhost:3306/reader_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=123456
# 对象存储（SeaweedFS）
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=reader-access-key
S3_SECRET_KEY=reader-secret-key-0055
